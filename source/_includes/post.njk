---
layout: layout.njk
---

<script type="module">
  const pluralRules = new Intl.PluralRules('en-US');

  function getPluralForm(count) {
    return pluralRules.select(count);
  }

  function getWords(str) {
    return str.toLowerCase() // Normalize the string to lowercase (optional)
      .trim() // Trim leading and trailing whitespace
      .split(/\s+/) // Use a regular expression to split the string into words
      .filter(word => word.length > 0);
}


  function pluralize(count) {
    const pluralForm = getPluralForm(count)
    return pluralForm === 'zero' ?
      `${count} views` :
      `${count} view${count !== 1 ? 's' : ''}`;
  }

  // View count is shown only once it loads, so nothing flashes
  try {
    const addRes = await fetch('/api/add-view');
    const { count } = await addRes.json();
    if (String(count).match(/^\d+$/)) {
      const vcEl = document.getElementById('view-count');
      vcEl.innerText = ` · ${pluralize(count)}`;
      vcEl.hidden = false;
    }
  } catch (e) {
    console.error('Could not load view count', e);
  }
</script>

{# Book posts: continue the "open book" transition from Recently Read #}
{% if tags and "books" in tags %}
<style>
  @view-transition { navigation: auto; }
  .post > article { view-transition-name: book; }
  ::view-transition-group(book) {
    animation-duration: 0.5s;
    animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
  }
  ::view-transition-old(book),
  ::view-transition-new(book) {
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
</style>
{% endif %}

<div class='post bb b--black-10 mb2'>
  <article class='mb3 mw7 center'>
    <header class='bb b--black-10 mv3'>
      <time class='post-date' datetime="{{page.date.toISOString()}}">{{page.date | fullDate }}</time>
      <h1 class='post--title'>{{title}}</h1>
      <section class="mb2">
        {% for tag in tags  %}
          {% tagLink tag %}
        {% endfor %}
      </section>
      <section id="wm-likes" class="wm-likes wm-hidden flex">
        <ul class="mb0"></ul>
        <p id="wm-like-count" class="ml2 mb0"></p>
      </section>
      <section class="post-stats">
        <p>{{ content | readingTime }}<span id="view-count" hidden></span></p>
      </section>
    </header>
    <section id="article-content">
      {{content | safe }}
    </section>
  </article>

  <footer class='post-footer mw7 center'>
    <p class='post-share'>
      Thanks for reading. If you liked this,
      <a href="{% blueskyShareURL title %}" target="_blank" rel="noopener">share it on Bluesky</a>
      or subscribe via <a href="/feed.xml">RSS</a>. Or don't, that's also ok.
    </p>

    {% set newerPost = collections.writing | getPreviousCollectionItem(page) %}
    {% set olderPost = collections.writing | getNextCollectionItem(page) %}
    {% if newerPost or olderPost %}
      <nav class='post-nav' aria-label="More posts">
        {% if olderPost %}
          <a class='post-nav--prev' href="{{olderPost.url}}"><small>← Older</small>{{olderPost.data.title}}</a>
        {% endif %}
        {% if newerPost %}
          <a class='post-nav--next' href="{{newerPost.url}}"><small>Newer →</small>{{newerPost.data.title}}</a>
        {% endif %}
      </nav>
    {% endif %}

    <p><a href="/writing/">← All writing</a></p>
  </footer>
</div>

{# TODO: looks bad when there are no replies, likes get centered #}
<aside id="webmentions" class="webmentions mb3">
  <section id="wm-replies" class="wm-replies wm-hidden mw7 center">
    <h2>Replies <span id="wm-reply-count"></span></h2>
    <ul></ul>
  </section>

  <template id="wm-like">
    <li>
      <a href="" id="wm-reply-author-url">
        <img eleventy:ignore alt="" id="wm-reply-author-photo" class="wm-reply-author-photo" width="25" height="auto" src="">
      </a>
    </li>
  </template>

  <template id="wm-reply">
    <li>
      <div class="flex items-end mb2 bb pb2 b--black-10">
        <img eleventy:ignore alt="" id="wm-reply-author-photo" class="wm-reply-author-photo mr1" width="40" height="auto" src="">
        <span id="wm-reply-author" class="wm-reply-author"></span>
        <span id="wm-reply-date"></span>
      </div>
      <div id="wm-reply-text"></div>
      <span id="wm-reply-link" class="wm-reply-link"></span>
    </li>
  </template>
</aside>

<script src={{"/javascript/webmentions.js" | url }}></script>
<script>
  window.fetchWebMentions("{{page.url}}");
</script>
