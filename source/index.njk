---
layout: layout.njk
eleventyExcludeFromCollections: true
---

<div class="home">
  <section class="intro">
    <img class="intro-avatar" alt="" width="72" height="72" sizes="72px" eleventy:widths="72,144" loading="eager" src="/images/avatar.jpeg">
    <div>
    <p>
      👋🏾 I'm a member of technical staff at <a href="https://vercel.com">Vercel</a>.
      Before that, I worked at Apple. I think about programming, tools, and
      how engineering teams work.
    </p>

    <ul class="intro-links">
      <li>🎬 <a href="/blog/category/recently-watched">Recently Watched</a></li>
      <li>📚 <a href="/blog/category/recently-read">Recently Read</a></li>
      <li>📄 <a href="/resume">Resume</a></li>
    </ul>
    </div>
  </section>

  <section class="posts">
    <h2 class="section-title">Recent Writing</h2>
    <ul class="post-list">
      {% for post in collections.writing %}{% if loop.index <= 10 %}
        <li class="post-link">
          <a href="{{post.url}}">{{post.data.title}}</a>
          <time class="date" datetime="{{post.date.toISOString()}}">{{post.data.date | fullDate }}</time>
        </li>
      {% endif %}{% endfor %}
    </ul>
    <p class="see-all"><a href="/writing/">All writing →</a></p>
  </section>
</div>

{# Hero avatar morphs into the sticky header avatar on scroll #}
<script>
  (() => {
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    const hero = document.querySelector(".intro-avatar");
    const target = document.querySelector(".header-content--avatar");
    const header = document.querySelector(".site-header");
    if (!hero || !target) return;

    document.documentElement.classList.add("hero-morph");
    let start, end, dist, ticking = false;

    const measure = () => {
      hero.style.transform = "";
      const h = hero.getBoundingClientRect();
      const t = target.getBoundingClientRect();
      start = { x: h.left, y: h.top + scrollY, w: h.width };
      end = { x: t.left, y: t.top, w: t.width };
      dist = Math.max(120, start.y - end.y);
      update();
    };

    const update = () => {
      ticking = false;
      const p = Math.min(1, Math.max(0, scrollY / dist));
      const x = start.x + (end.x - start.x) * p;
      const y = start.y + (end.y - start.y) * p;
      const s = 1 + (end.w / start.w - 1) * p;
      hero.style.transform =
        `translate(${x - start.x}px, ${y - (start.y - scrollY)}px) scale(${s})`;
      const done = p >= 1;
      hero.style.visibility = done ? "hidden" : "";
      header.classList.toggle("is-stuck", done);
    };

    addEventListener("scroll", () => {
      if (!ticking) { ticking = true; requestAnimationFrame(update); }
    }, { passive: true });
    addEventListener("resize", measure);
    addEventListener("load", measure);
    measure();
  })();
</script>
