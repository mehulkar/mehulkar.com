{% macro render(posts) %}
    {%- for year in posts -%}
        <div class="post-group">
            <h2 class="post-group--title">{{year.name}}</h2>

            <ul class="post-list">
                {% for post in year.items %}
                    <li class="post-link">
                        <a href="{{post.url}}">{{post.data.title}}</a>
                        <time class="date" datetime="{{post.date.toISOString()}}">{{post.data.date | formatDate }}</time>
                    </li>
                {% endfor %}
            </ul>
        </div>
    {%- endfor -%}
{% endmacro %}
