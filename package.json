{
  "name": "mehulkar.com",
  "private": true,
  "description": "Personal website of Mehul Kar",
  "scripts": {
    "start": "vercel dev",
    "dev": "eleventy --serve",
    "prebuild": "rm -rf ./_site",
    "build": "eleventy",
    "lint": "prettier -c 'source/**/*.md'",
    "lint:fix": "prettier -c 'source/**/*.md' --write",
    "new": "node scripts/new-post.mjs",
    "update-movies": "node scripts/letterboxd/index.mjs",
    "convert-tags": "node scripts/convert-tags.mjs",
    "fetch-tweets": "node scripts/fetch-tweets.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mehulkar/mehulkar.com.git"
  },
  "author": "Mehul Kar <mehul.kar@gmail.com>",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/mehulkar/mehulkar.com/issues"
  },
  "homepage": "https://github.com/mehulkar/mehulkar.com",
  "packageManager": "pnpm@12.23.0",
  "devDependencies": {
    "@11ty/eleventy": "3.1.8",
    "@11ty/eleventy-img": "^7.1.1",
    "@11ty/eleventy-plugin-rss": "^3.1.0",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
    "eleventy-plugin-activity-pub": "^0.1.1",
    "esbuild": "~0.28.2",
    "fast-glob": "^3.3.2",
    "js-yaml": "^4.1.0",
    "markdown-it-anchor": "^10.1.0",
    "prettier": "^3.10.1",
    "prismjs": "1.30.0",
    "rss-parser": "^3.13.0"
  },
  "engines": {
    "node": "26"
  },
  "type": "module"
}
